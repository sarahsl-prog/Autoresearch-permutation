# Copy to .env and edit. Nothing loads this automatically — uv does it for you:
#
#     export UV_ENV_FILE=.env       # once per shell, then `uv run train.py`
#     uv run --env-file .env train.py
#
# .env is gitignored. Values here are the built-in defaults unless noted.

# ---------------------------------------------------------------------------
# Experiment tracking (tracking.py)
# ---------------------------------------------------------------------------

MLFLOW_TRACKING_URI=http://192.168.0.252:5000
MLFLOW_EXPERIMENT_NAME=autoresearch

# An unreachable server costs ~2s per run thanks to a TCP preflight; these bound
# what happens when it is reachable but unwell. Raising them means a sick server
# eats into an overnight loop.
MLFLOW_HTTP_REQUEST_TIMEOUT=10
MLFLOW_HTTP_REQUEST_MAX_RETRIES=2

# Only needed if the tracking server keeps artifacts in S3 or MinIO. Without
# these every run logs its metrics fine but drops the train.py artifact with
# NoCredentialsError.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MLFLOW_S3_ENDPOINT_URL=http://your-minio:9000

# ---------------------------------------------------------------------------
# The goal (objective.py) — what the ratchet optimises
# ---------------------------------------------------------------------------

# min_bpb | min_bpb_under_vram | min_bpb_x_params
AUTORESEARCH_GOAL=min_bpb

# Only used by min_bpb_under_vram. The 20.0 default is a placeholder; set it from
# the card you actually have.
AUTORESEARCH_VRAM_LIMIT_GB=20.0

# Random seed. Deliberately out of the agent's reach: an agent free to change the
# seed can lower its score by shopping for a lucky initialisation, and the ratchet
# would keep it. Vary this to measure how much of an "improvement" is noise —
# run the same commit under 41..45 and look at the spread (see §6.1 of
# alternative-goals.md).
AUTORESEARCH_SEED=42

# Where the run log and the machine-readable summary go. Worth changing if you
# ever run two branches against the same checkout.
# AUTORESEARCH_RESULTS_PATH=results.jsonl
# AUTORESEARCH_RUN_JSON=run.json

# ---------------------------------------------------------------------------
# Harness constants (prepare.py) — human-only knobs
# ---------------------------------------------------------------------------
#
# Both change what a score MEANS. Changing either mid-campaign makes runs
# incomparable, so decide before the night starts, not during it. Both are
# recorded with every run, so a mismatch is at least visible afterwards.

# Wall-clock training seconds per experiment, excluding startup and compile.
# Longer runs give a cleaner signal per experiment but fewer experiments.
AUTORESEARCH_TIME_BUDGET=300

# Tokens used for the validation metric (default 40 * 524288 = ~21M). At ~500K
# tok/s that is roughly 40s of every run. Halving it buys experiments but raises
# the metric's noise floor, which raises the bar for calling a win real.
AUTORESEARCH_EVAL_TOKENS=20971520

# ---------------------------------------------------------------------------
# Compute (train.py, objective.py)
# ---------------------------------------------------------------------------

# auto | fa3 | sdpa. auto picks FA3 on Hopper and SDPA everywhere else. FA3 off
# Hopper is not merely slower — torch.compile cannot trace it.
ATTN_BACKEND=auto

# MFU denominator. Left unset, the harness measures achievable dense bf16
# throughput with one matmul at startup, which is usually what you want. Set it
# to a vendor peak figure if you would rather compare against that.
# AUTORESEARCH_PEAK_FLOPS=99.0e12

# ---------------------------------------------------------------------------
# Per-run, not really .env material
# ---------------------------------------------------------------------------
# AUTORESEARCH_NOTE — one-line description of the experiment; the agent passes
#   this per run, e.g. AUTORESEARCH_NOTE="increase LR" uv run train.py
# AUTORESEARCH_RUN_NAME — overrides the generated MLflow run name
